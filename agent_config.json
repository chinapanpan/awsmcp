{
  "agent": {
    "system_prompt_file": null,
    "model_id": "us.anthropic.claude-sonnet-4-6",
    "region": "us-east-1"
  },
  "mcp_servers": [
    {
      "name": "aws-api",
      "enabled": true,
      "type": "stdio",
      "command": "uvx",
      "args": ["awslabs.aws-api-mcp-server@latest"],
      "env": {
        "AWS_REGION": "us-east-1",
        "AWS_API_MCP_WORKING_DIR": "/tmp/aws-api-mcp"
      },
      "startup_timeout": 120
    }
  ],
  "skills": [
    {
      "source": "./skills/aws-cost-advisor",
      "enabled": true
    },
    {
      "source": "./skills/aws-security-check",
      "enabled": true
    }
  ],
  "remote_mcp_server": {
    "name": "aws-agent-mcp-server",
    "host": "0.0.0.0",
    "port": 8080
  }
}
