{
  "agent": {
    "system_prompt_file": null,
    "model_id": "us.anthropic.claude-sonnet-4-6",
    "region": "us-east-1"
  },
  "mcp_servers": [
    {
      "name": "aws-api",
      "enabled": true,
      "type": "stdio",
      "command": "uvx",
      "args": ["awslabs.aws-api-mcp-server@latest"],
      "env": {
        "AWS_REGION": "us-east-1",
        "AWS_API_MCP_WORKING_DIR": "/tmp/aws-api-mcp"
      },
      "startup_timeout": 120
    }
  ],
  "skills": [
    {
      "name": "current_time",
      "enabled": true,
      "type": "builtin",
      "module": "strands_tools.current_time"
    },
    {
      "name": "think",
      "enabled": false,
      "type": "builtin",
      "module": "strands_tools.think"
    },
    {
      "name": "example_custom_skill",
      "enabled": false,
      "type": "custom",
      "path": "./skills/example_custom_skill.py"
    }
  ],
  "remote_mcp_server": {
    "name": "aws-agent-mcp-server",
    "host": "0.0.0.0",
    "port": 8080
  }
}
