{
  "agent": {
    "system_prompt_file": null,
    "model_id": "us.anthropic.claude-sonnet-4-6",
    "region": "us-east-1"
  },
  "mcp_servers": [
    {
      "name": "aws-api",
      "enabled": true,
      "type": "stdio",
      "command": "uvx",
      "args": ["awslabs.aws-api-mcp-server@latest"],
      "env": {
        "AWS_REGION": "us-east-1",
        "AWS_API_MCP_WORKING_DIR": "/tmp/aws-api-mcp"
      },
      "startup_timeout": 120
    }
  ],
  "remote_mcp_server": {
    "name": "aws-agent-mcp-server",
    "host": "0.0.0.0",
    "port": 8080,
    "tools": [
      {
        "name": "aws_agent_chat",
        "description": "与 AWS 专家 Agent 进行自然语言对话。可以询问 AWS 相关问题、查询资源状态、执行云服务操作等。",
        "enabled": true
      },
      {
        "name": "aws_agent_execute",
        "description": "执行特定的 AWS 云服务操作任务。适用于明确的操作指令。",
        "enabled": true
      }
    ]
  }
}
